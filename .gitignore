# Local Python environment
.venv/

# Python-generated cache directories
__pycache__/

# LaTeX auxiliary build files (the compiled PDFs remain tracked)
*.aux
*.log
*.nav
*.out
*.snm
*.toc
*.vrb
*.fls
*.fdb_latexmk
*.synctex.gz

# Local reference material: review publishing rights before tracking it
/OtherMaterial/

# Scraper cache (raw API replies; regenerated by 05_scale_up.py)
slides/web-scraping/data/cache/

# Page images produced when proof-reading a deck
slides/**/_*.png
