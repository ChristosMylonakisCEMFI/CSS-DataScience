{
  "name": "Growth calculator",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",

  // The three packages python_basics.py needs. A brand-new Codespace has Python
  // but nothing else, so without this line participants would have to install
  // them by hand - thirty people at once, in the middle of a session. ipykernel
  // is what lets VS Code run one "# %%" block at a time.
  "postCreateCommand": "pip install 'pandas>=1.4' 'matplotlib>=3.5' 'ipykernel>=6.0'",

  // Do not hand over the editor until the line above has finished.
  "waitFor": "postCreateCommand",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  }
}
